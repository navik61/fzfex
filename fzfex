#!/usr/bin/env python3
"""fzfex – fzf s náhledem v externím okně (niri / Wayland).

Použití:
    fzfex [volby fzf...]          # vstup ze stdin, jinak FZF_DEFAULT_COMMAND
    fzfex -E [volby fzf...]       # náhled na externím monitoru (výchozí DP-2)
    fzfex --external=VÝSTUP ...   # náhled na zadaném monitoru
    fzfex -E -m                   # náhled na interním monitoru, Tab ho připne na externí (mřížka)
Enter = nabídka „Otevřít v…“ (po otevření fzfex skončí), alt-enter = vypsat výběr.
Interní podpříkazy (volá je fzf):
    fzfex --show CESTA...         # zobraz náhled(y) (neblokuje, debounce)
    fzfex --show-list SOUBOR...   # totéž, cesty po řádcích v souborech ({+f} {f} z fzf)
    fzfex --info CESTA            # text do vnitřního preview panelu fzf
    fzfex --toggle SOUBOR         # zapni/vypni externí náhled
    fzfex --menu SOUBOR           # nabídka aplikací (fzf transform)
    fzfex --close                 # zavři aktuální náhledová okna
    fzfex --focus                 # fokus terminál -> náhled -> další náhled -> terminál
                                  # (ctrl-v ve fzf; lze navázat i na globální zkratku niri)
"""

import fcntl
import fnmatch
import glob
